// OpenCode settings, hand-written.
{
  "$schema": "https://opencode.ai/config.json",
  // Cloud model by default; EZLM must not change this.
  "model": "spark/deepseek-v4.1-flash", // the default
  "theme": "system",
  "provider": {
    /* the Spark ring */
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://spark.example.ts.net/v1", "apiKey": "{file:~/.config/opencode/deepseek.key}" },
      "models": {
        "deepseek-v4.1-flash": { "tool_call": true, "limit": { "context": 1000000, "output": 32768 } }, // big
      },
    },
  },
  "keybinds": { "leader": "ctrl+x" }, // trailing comma follows
}
